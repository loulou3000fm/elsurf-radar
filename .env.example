# Copier ce fichier en ".env" pour envoyer l'email en local (le .env n'est jamais commité).
# Sur GitHub Actions, ces valeurs sont à définir dans les secrets du dépôt.

# Clé API Resend (https://resend.com/api-keys).
RESEND_API_KEY=

# Expéditeur. Sans domaine vérifié chez Resend, utiliser onboarding@resend.dev
# (dans ce cas, seul l'email du compte Resend peut être destinataire).
EMAIL_FROM=onboarding@resend.dev

# Destinataire du récap.
EMAIL_TO=
